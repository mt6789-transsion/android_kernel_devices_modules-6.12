# Platform
CONFIG_ARCH_MEDIATEK=y
CONFIG_MTK_PLAT_POWER_6789=y

# TEE
CONFIG_TRUSTONIC_TEE_SUPPORT=m
CONFIG_TRUSTONIC_TEE_VERSION="510"

# Audio
CONFIG_SND_SOC_MT6789=m
CONFIG_SND_SOC_MT6366=m
CONFIG_SND_SOC_MT6789_MT6366=m
CONFIG_SND_SOC_AW87XXX=m

# Power & Charging
CONFIG_BATTERY_MT6358=m
CONFIG_CHARGER_HL7138=m
CONFIG_CHARGER_SC8950=m
CONFIG_TCPC_RT1711H=m

# Flashlight
CONFIG_MTK_FLASHLIGHT_OCP81375=m
